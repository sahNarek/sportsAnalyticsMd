library(dplyr)
library(elo)
library(ggplot2)
library(elo)
elo.prob(elo.A=1500, elo.B=1500)
elo.prob(elo.A=1900, elo.B=1500)
# The odds
elo.prob(elo.A=1900, elo.B=1500)/(1-elo.prob(elo.A=1900, elo.B=1500))
# prob for A
elo.prob(elo.A=1500, elo.B=1600)
1500+20*(1-0.359935)
elo.prob(elo.A=1600, elo.B=1500)
1600+20*(0-0.640065)

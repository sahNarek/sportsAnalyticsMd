elo.update(elo.A=1500,elo.B=1600,wins.A=1, k=20)
library(SportsAnalytics270)
data(epl_00_18)
str(epl_00_18)
score(2,0)
score(0,0)
score(0,1)
elos <- elo.run(score(HG, AG) ~ Home + Away,
data = epl_00_18, k = 20)
elos_df <- as.data.frame(elos)
tail(elos_df, n=10)
head(elos_df)
epl_last <- tail(elos_df, n=10)
epl_last
elo_final <- final.elos(elos)
sort(elo_final, decreasing = T)
epl2 <- elo.run(score(HG, AG) ~ adjust(Home, 200) +
Away,  data = epl_00_18, k = 20)
sort(final.elos(epl2), decreasing = T)
epl_00_18$G <- ifelse(abs(epl_00_18$HG-epl_00_18$AG)<=1, 1,
ifelse(abs(epl_00_18$HG-epl_00_18$AG)==2,1.5,
(abs(epl_00_18$HG-epl_00_18$AG)+11)/8))
head(epl_00_18,5)
epl3<-elo.run(score(HG, AG) ~ adjust(Home, 200) + Away +
k(20*epl_00_18$G),  data = epl_00_18 )
sort(final.elos(epl3), decreasing = T)
epl2 <- elo.run(score(HG, AG) ~ adjust(Home, 50) +
Away,  data = epl_00_18, k = 20)
epl2 <- as.data.frame(epl2)
epl2 <- data.frame(epl2, epl_00_18[,c("Round","Season")])
head(epl2, n=4)
elo.prob(elo.A = 1500+50, elo.B = 1500)
library(measures)
library(dplyr)
epl2 %>%
group_by(Season) %>%
summarise(Brier = Brier(p.A, wins.A, positive=1)) %>%
arrange(desc(Brier))
epl2 %>%
mutate(Deviations = (p.A-wins.A)^2) %>%
group_by(Season) %>%
summarise(Brier = mean(Deviations)) %>%
arrange(desc(Brier))
epl2 %>%
mutate(Deviations = (p.A-wins.A)^2) %>%
group_by(Season) %>%
summarise(Mean_BS = mean(Deviations)) %>%
ggplot(aes(x=Season, y=Mean_BS))+geom_line()
epl2$Predicted <- ifelse(epl2$p.A>=0.55, 1,
ifelse(epl2$p.A<=0.45,0,0.5))
library(caret)
confusion <- table(epl2$wins.A, epl2$Predicted)
sum(diag(confusion))/nrow(epl2)
elo_table <- data.frame(Competition = c("Friendly match", "All minor tournaments",
"World Cup and continental qualifiers and major tournaments",
"Continental championship finals and major intercontinental tournaments",
"FIFA World Cup finals"),
Multiplier = c(20,30,40,50,60))
elo_table
knitr::include_graphics("./images/elo_picture.png")
help(knitr::include_graphics)
install.packages("flexdashboard")
